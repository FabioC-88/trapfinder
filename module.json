{
  "id": "trapfinder",
  "title": "GM Toolkit (dnd5e)",
  "description": "Tools and automations for running dnd5e sessions: passive detection of traps, hidden clues and secret doors, detection of hidden creatures with a surprise proposal, and lockpicking. They automate passive checks without stopping the table for a roll. These are not house rules (optional rule variants): they are GM utilities.",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Fabio"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "4.0.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "reason": "If installed, the module uses it to safely intercept clicks on locked doors (it still works without it, through a bundled shim)."
      }
    ]
  },
  "esmodules": [
    "lib/libwrapper-shim.js",
    "scripts/main.js"
  ],
  "styles": [
    "tools/party-encumbrance/party-encumbrance.css"
  ],
  "documentTypes": {
    "RegionBehavior": {
      "trapDetection": {},
      "passiveDetection": {}
    }
  },
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "it",
      "name": "Italiano",
      "path": "lang/it.json"
    }
  ],
  "url": "https://github.com/FabioC-88/trapfinder",
  "manifest": "https://github.com/FabioC-88/trapfinder/releases/latest/download/module.json",
  "download": "https://github.com/FabioC-88/trapfinder/releases/download/v0.1.0/trapfinder-v0.1.0.zip",
  "readme": "https://github.com/FabioC-88/trapfinder/blob/main/README.md",
  "license": "LICENSE"
}
